CompileFlags:
    CompilationDatabase: build
    Compiler: /usr/bin/clang++
    Add:
        - -std=c++20
        - -x
        - c++
        - -I/usr/local/cuda/include
        - -include
        - /workspace/cmake/utils/clangd_wmma.h
        - -D__host__=
        - -D__device__=
        - -D__global__=
        - -D__shared__=
        - -D__syncthreads()=(void)0
        - -D__device_builtin__=
        - -DEIGEN_NO_CUDA=1
        - -D_NV_RSQRT_SPECIFIER=
        - -D__CUDA_NO_GLOBAL_OPERATOR_NEW__
        - -DBENCHMARK_STATIC_DEFINE
        - -Iwork1/core/include
        - -Iwork2/core/include
        - -Iwork3/core/include
        - -Iwork4/core/include
        - -Ibuild/_deps/eigen-src
        - -Ibuild/_deps/benchmark-src/include
        - -Ibuild/_deps/googletest-src/googletest/include
        - -Wno-unknown-cuda-version
        - -Wno-ignored-pragmas
    Remove:
        - -std=*
        - -forward-unknown-to-host-compiler
        - --generate-code=*
        - -arch=*
        - -Xcompiler=*
        - -rdc=*
        - -Wno-deprecated-gpu-targets
        - --expt-relaxed-constexpr
        - -fdeps-format=*
        - -static-global-template-stub=*
        - --cuda-gpu-arch=*
        - --cuda-path=*
        - --cuda-host-only
        - -xcuda
        - -x
        - cu

Diagnostics:
    ClangTidy:
        Remove:
            - "*"
    Suppress:
        - ovl_no_viable_function_in_call
        - ref_bad_target
        - expected_expression
        - unused-includes
        - unknown_typename
        - typename_nested_not_found
